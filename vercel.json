{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/server/static/index.html" },
    { "source": "/static/:path*", "destination": "/server/static/:path*" },
    {
      "source": "/api/:path*",
      "destination": "https://shadowtrace-ai-gwho.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/server/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
